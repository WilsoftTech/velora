# TMDB credentials (server-side only — never prefix with NEXT_PUBLIC_).
# Use either the v4 "API Read Access Token" (preferred) or the v3 API key.
# With neither set, Verola runs on a small built-in sample catalogue.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Public origin used for canonical URLs and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
