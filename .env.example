# TMDB credentials (server-side only — never prefix with NEXT_PUBLIC_).
# Use either the v4 "API Read Access Token" (preferred) or the v3 API key.
# With neither set, Velora runs on a small built-in sample catalogue.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Public origin used for canonical URLs and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# VELORA — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development.
# Never commit `.env.local` or real secrets.
#
# IMPORTANT:
# - NEXT_PUBLIC_* variables are exposed to the browser.
# - Never prefix private API keys or service-role credentials with NEXT_PUBLIC_.
# =============================================================================


# =============================================================================
# 1. APPLICATION
# =============================================================================

# Public application URL.
# Local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production example:
# NEXT_PUBLIC_SITE_URL=https://velora.app

# Environment name:
# development | preview | production
NEXT_PUBLIC_APP_ENV=development


# =============================================================================
# 2. TMDB — MOVIE & TV DATA
# =============================================================================
# Get credentials from your TMDB developer account.
#
# Prefer TMDB_ACCESS_TOKEN (v4 Read Access Token).
# Keep these SERVER-SIDE ONLY.

# Usually does not need changing.
TMDB_API_BASE_URL=https://api.themoviedb.org/3

# Public TMDB image CDN.
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p


# =============================================================================
# 3. SUPABASE — PHASE 2
# =============================================================================
# Used for:
# - Authentication
# - PostgreSQL database
# - Profiles
# - Persistent watchlists
# - Search history
# - Personalization data
#
# With these two unset, Velora runs as a guest-only discovery app (My List stays
# in localStorage). Production builds on Vercel fail if they are missing.

NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe publishable key (Dashboard → Project Settings → API Keys).
# Row Level Security, not this key, is what protects user data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY — not read by the app in Phase 2. Never use NEXT_PUBLIC_ for it.
# Reserved for privileged jobs such as account deletion (Phase 7).
SUPABASE_SERVICE_ROLE_KEY=


# =============================================================================
# 4. DATABASE — PHASE 2+
# =============================================================================
# PostgreSQL connection strings. Not read by the app in Phase 2 (it talks to
# Supabase through supabase-js). Keep them out of Vercel unless tooling needs them.
#
# DATABASE_URL:
# Usually the pooled connection.
#
# DIRECT_URL:
# Direct database connection, typically used by migration tooling.

DATABASE_URL=
DIRECT_URL=


# =============================================================================
# 5. APPLICATION SECURITY
# =============================================================================
# Optional server-side secret for signing/encryption if Velora later needs
# application-managed cryptographic operations.
#
# Generate a strong secret, for example:
#
# openssl rand -base64 32

APP_SECRET=

# Canonical server-side auth origin if explicitly required.
AUTH_URL=http://localhost:3000


# =============================================================================
# 6. EMAIL — OPTIONAL / FUTURE
# =============================================================================
# Only required if Velora sends transactional emails directly.
#
# Example provider: Resend.
#
# Uncomment when implemented.

# RESEND_API_KEY=
# EMAIL_FROM=Velora <noreply@example.com>


# =============================================================================
# 7. RATE LIMITING / REDIS — PHASE 6
# =============================================================================
# Optional.
#
# Can be used for:
# - API rate limiting
# - Search/event abuse prevention
# - Expensive server endpoint protection
# - Lightweight caching
#
# Example provider: Upstash Redis.
#
# Do not introduce until there is an actual requirement.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# =============================================================================
# 8. SENTRY — PHASE 6
# =============================================================================
# Production error monitoring.

# Browser-safe DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Server-side DSN.
SENTRY_DSN=

# Used by Sentry build tooling / source-map uploads.
# SERVER / CI ONLY.
SENTRY_AUTH_TOKEN=

SENTRY_ORG=
SENTRY_PROJECT=

# development | preview | production
SENTRY_ENVIRONMENT=


# =============================================================================
# 9. POSTHOG — PHASE 7
# =============================================================================
# Product analytics.
#
# Potential events:
# - search
# - media_view
# - watchlist_add
# - watchlist_remove
# - signup
# - login
# - trailer_play

NEXT_PUBLIC_POSTHOG_KEY=

# Change if using another PostHog region or self-hosted instance.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional server-side PostHog credential.
POSTHOG_API_KEY=


# =============================================================================
# 10. VERCEL
# =============================================================================
# Vercel automatically provides variables such as:
#
# VERCEL
# VERCEL_ENV
# VERCEL_URL
# VERCEL_GIT_COMMIT_SHA
#
# Do NOT manually define these here.
#
# Explicitly configure NEXT_PUBLIC_SITE_URL in Vercel for production so
# canonical URLs and metadata use Velora's real production domain.


# =============================================================================
# 11. TESTING — PHASE 6
# =============================================================================

# Playwright / E2E application URL.
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Dedicated TEST account only.
# Never put a real user's credentials here.

E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=


# =============================================================================
# 12. OPTIONAL FEATURE FLAGS
# =============================================================================
# Only introduce flags when deployment-level control is genuinely useful.
#
# Uncomment when implemented.

# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_PWA=false
# NEXT_PUBLIC_ENABLE_PERSONALIZATION=false